# Copy to .env.local and fill in from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Needed from step 3 (admin creates users). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- VPS deployment only (docker compose reads .env) ----
# Full hostname for the app; Caddy gets the HTTPS certificate for it.
DOMAIN=tasks.yourdomain.com
# For nightly backups. Supabase: Connect -> Session pooler (IPv4) connection string.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
